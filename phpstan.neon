includes:
    - %currentWorkingDirectory%/.build/vendor/magicsunday/coding-standard/phpstan/strict.neon

parameters:
    # PHP Version to check against (PHP 8.3 as minimum target)
    phpVersion: 80300

    tmpDir: %currentWorkingDirectory%/.build/cache/.phpstan.cache

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/tests/

    # Makes the public surface of the optional occupation-standardization
    # provider (hartenthaler/hh_occupation_standardizer) discoverable to static
    # analysis. The module is an optional runtime dependency resolved via
    # ModuleService and never required by this package, so its classes are not on
    # the autoload path; scanning this file lets the adapter type-check without
    # the provider being installed.
    scanFiles:
        - %currentWorkingDirectory%/stubs/hh_occupation_standardizer.stub

    excludePaths:
        - %currentWorkingDirectory%/.build/

    ignoreErrors:
        # symplify forbiddenTrait bans traits wholesale. They are a deliberate
        # house idiom here, the module-base sharing traits.
        -
            identifier: symplify.forbiddenTrait
            paths:
                - src/Traits/*

        # &-references are in/out accumulators (depth cache, visited set) for
        # recursive graph traversal; copy-free, an explicit return would force a
        # copy-and-reassign on every recursion.
        -
            identifier: symplify.noReference
            paths:
                - src/Support/Calc/GenerationDepth.php
                - src/Support/Calc/PartnershipChains.php
                - src/Repository/IslandRepository.php

        # method_exists() is a legitimate API-presence probe in this contract test.
        -
            identifier: symplify.forbiddenFuncCall
            path: tests/ModuleTest.php

        # Closure parameters required positionally by a typed callable contract
        # (the LineChartPayload projector, the MarriageExtremes mapper), unused in
        # these specific test bodies — cannot be dropped.
        -
            identifier: shipmonk.unusedParameter
            paths:
                - tests/Unit/Payload/LineChartPayloadTest.php
                - tests/View/MarriageExtremesViewTest.php

        # The ext-calendar stub spells gregoriantojd in PascalCase, so a call in
        # the lowercase spelling of the PHP manual raises `function.nameCase`.
        # Suppress just this one mismatch. Delete the entry and run
        # `composer ci:test:php:phpstan` to see whether the stub still needs it.
        -
            identifier: function.nameCase
            path: src/Support/Database/LivingIndividuals.php

        # The aggregate fragments deliberately embed the connection table prefix
        # (`DB::connection()->getTablePrefix()`) and the physical table name, so
        # the MIN/MAX/SUM references the actual prefixed table. That is trusted but
        # provably non-literal, and a newer illuminate rejects it in the raw-SQL
        # builder calls. A module release must stay green against the released
        # webtrees as well, where the error does not occur, so each block sets
        # `reportUnmatched: false`. Delete an entry and run
        # `composer ci:test:php:phpstan` on each resolve to see where it applies.
        -
            message: '#expects (literal-string|TValue of float\|int\|literal-string)#'
            identifier: argument.type
            reportUnmatched: false
            paths:
                - src/Repository/FamilyRankingRepository.php
                - src/Repository/LifeSpanRepository.php
                - src/Support/Database/DateAggregate.php

        # Same cause, surfacing on the `@return Expression<…>` generics.
        -
            message: '#generic type Illuminate.+Expression#'
            identifier: generics.notSubtype
            reportUnmatched: false
            paths:
                - src/Repository/LifeSpanRepository.php
                - src/Support/Database/DateAggregate.php

        -
            message: '#should return Illuminate.+Expression<non-falsy-string>#'
            identifier: return.type
            reportUnmatched: false
            path: src/Support/Database/DateAggregate.php
