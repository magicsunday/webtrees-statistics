declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use MagicSunday\Webtrees\Statistic\Payload\SankeyFlowsPayload;
use MagicSunday\Webtrees\Statistic\View\EmptyStatePlaceholder;
use MagicSunday\Webtrees\Statistic\View\WidgetJson;

/**
 * @var string             $identifier Host element id
 * @var SankeyFlowsPayload $data       Bipartite Sankey payload (e.g. Statistic::getMigrationFlows() or ::getOccupationInheritance()) — serialises to JSON via JsonSerializable
 * @var int|null           $height     Optional viewport height (defaults to 360)
 */
$height ??= 360;

if (($data->nodes === []) || ($data->links === [])) {
    echo EmptyStatePlaceholder::render();

    return;
}

// chart-lib sankey-flow reads `options.i18n.totalSingular / totalPlural`
// to localise the per-link tooltip count ("3 individuals" → "3 Personen").
// Curly-brace {count} placeholder instead of sprintf %s — see the
// StreamGraph partial for the rationale.
$sankeyI18n = [
    'totalSingular' => I18N::translate('{count} individual'),
    'totalPlural'   => I18N::translate('{count} individuals'),
];

// The widget draws its node labels inside the drawing area, so only a small margin
// is needed. The wide default margin of the widget would leave a narrow screen a
// drawing of a fraction of its width.
$sankeyMargin = ['top' => 8, 'right' => 12, 'bottom' => 8, 'left' => 12];
?>
<div id="<?php echo e($identifier); ?>"
     class="wt-stat-sankey-flow-container"
     data-widget="sankey-flow"
     data-payload="<?php echo WidgetJson::encodeAttribute($data); ?>"
     data-options="<?php echo WidgetJson::encodeAttribute(['height' => $height, 'margin' => $sankeyMargin, 'i18n' => $sankeyI18n]); ?>"
     data-empty-message="<?php echo e(EmptyStatePlaceholder::defaultMessage()); ?>"
></div>
